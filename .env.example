# IP-SAKTI Sahayak — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Django ────────────────────────────────────────────────────
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-minimum-50-chars!!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── AI / Ollama ────────────────────────────────────────────────
# Local: http://127.0.0.1:11434
# Docker web→host Ollama: http://host.docker.internal:11434
# Docker compose profile "ollama": http://ollama:11434
# Railway: https://<cloudflared-or-ngrok-host>  (NOT 127.0.0.1)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# CPU-only box → 3b. Better hardware → qwen2.5:7b-instruct-q4_K_M
OLLAMA_TIMEOUT=120

# ── Embeddings ─────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
# EMBED_DEVICE=cuda   ← uncomment if GPU available

# ── Chroma vector store ────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── DPDP-aligned audit (HMAC key — rotate per deployment) ─────
AUDIT_HMAC_KEY=CHANGE_THIS_TO_32_RANDOM_CHARS_MIN
AUDIT_HMAC_KEY_ID=v1

# ── Demo / feature flags ──────────────────────────────────────
DEMO_MODE=True
# DEMO_MODE=True  → stub / illustrative answers (safe for cloud UI-only).
# DEMO_MODE=False → live pipeline (needs reachable Ollama; RAG needs Chroma index).

# ── Translation ───────────────────────────────────────────────
TRANSLATE_BACKEND=ollama

# ── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_ASK_PER_MIN=10

# ── Railway / PaaS (set in dashboard or `railway variables`) ───
# DATA_DIR=/data
# DATABASE_URL=postgresql://...
# DEBUG=False
# DEMO_MODE=False
# OLLAMA_BASE_URL=https://your-tunnel.example
# ALLOWED_HOSTS=.up.railway.app,ip-sakti-sahayak-production-4c21.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://ip-sakti-sahayak-production-4c21.up.railway.app
