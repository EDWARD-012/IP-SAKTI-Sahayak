# IP-SAKTI Sahayak — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Django ────────────────────────────────────────────────────
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-minimum-50-chars!!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── AI / Ollama ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b-instruct-q4_K_M
# CPU-only box → use 3b (fast). Better hardware (8GB+ VRAM) → qwen2.5:7b-instruct-q4_K_M
OLLAMA_TIMEOUT=45

# ── Embeddings ─────────────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
EMBED_DEVICE=cpu
# EMBED_DEVICE=cuda   ← uncomment if GPU available

# ── Chroma vector store ────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── DPDP-aligned audit (HMAC key — rotate per deployment) ─────
AUDIT_HMAC_KEY=CHANGE_THIS_TO_32_RANDOM_CHARS_MIN
AUDIT_HMAC_KEY_ID=v1

# ── Demo / feature flags ──────────────────────────────────────
DEMO_MODE=True
# When DEMO_MODE=True the RAG pipeline is stubbed with placeholder responses.
# Set to False only after: Ollama running + corpus indexed.

# ── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_ASK_PER_MIN=10

# ── Production overrides (uncomment for deploy) ───────────────
# DEBUG=False
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# DATABASE_URL=sqlite:///./db.sqlite3
